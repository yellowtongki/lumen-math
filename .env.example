# 맥미니에서 쓸 열쇠 모음 — 이 파일을 복사해 .env 로 만들고 값을 채운다
# .env 는 .gitignore 에 걸려 있어 커밋되지 않는다. 값은 절대 여기에 적지 않는다.
#
#   cp .env.example .env     하고 값을 채운 뒤
#   set -a; source .env; set +a      (또는 ~/.zshrc 에 export 로 적어둔다)

# 학원 데이터 (글감 뽑기·진도 레이스 기록 등에 쓴다)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 카드 배경 그림 (선택)
OPENAI_API_KEY=

# 검색량 조회 (선택) — 네이버 검색광고 API
NAVER_AD_CUSTOMER_ID=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=

# 인스타 업로드 (선택) — Instagram Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=
