# Node / Playwright
node_modules/
package-lock.json

# 로그인·수집 테스트 디버그 산출물 (스크린샷 등 개인정보 포함 가능 → 커밋 금지)
sync/_debug/

# Claude Code 개인 설정 (커밋 제외)
.claude/settings.local.json
blackban_weekly_v1.html

# 오퍼스 서브에이전트 작업 사본 (git worktree) — 커밋 제외
.claude/worktrees/

# 맥미니에서 쓰는 열쇠 파일 — 절대 커밋하지 않는다
sync/.env.local

# 블로그 카드 폰트(Pretendard, 실행 시 자동 내려받음 · 4MB) · 카드 렌더 중간 HTML — 커밋 제외
sync/_fonts/
blog/**/cards/html/
# 검색 점검 때 찍은 화면 (용량 큼) — 커밋 제외
sync/_debug/serp/
# 카드 수식 렌더용 MathJax 사본 (실행 시 자동으로 받음, 2MB) — 커밋 제외
sync/_vendor/
_mjlocal/
# 네이버 로그인 상태(쿠키) — 절대 커밋 금지
sync/_naver_profile/
# 루멘이사회 — 학생 기록·실명 명단·리포트는 공개 저장소에 올리지 않는다
board/students/*
!board/students/_example/
board/private/*
!board/private/README.md
board/reports/

# 학교 시험 문제 원문·기출 연도가 박힌 카드 — 공개 저장소에 두지 않는다 (2026-10-17)
blog/**/_withheld/
# 학원앱이 내려준 원자료(.md) — 지난 시험 유형·연도가 들어 있다
blog/**/학원앱_블로그자료.md

# 키·비밀번호 — 절대 커밋 금지 (맥미니에서 .env 를 쓴다)
.env
.env.*
!.env.example

# 당근 로그인 상태 (쿠키) — 절대 올리지 않는다
sync/_daangn_profile/

# 숏츠 중간 파일 — 장면 html·png 는 안 올린다 (mp4 만 남긴다)
blog/**/shorts/*.html
blog/**/shorts/scene_*.png
